# The dependency is the sole owner of native URLs, hashes and extraction.
function(bilisail_media_manifest output)
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../.dart_tool/package_config.json" config)
  string(JSON count LENGTH "${config}" packages)
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON name GET "${config}" packages ${index} name)
    if(name STREQUAL "media_kit_libs_windows_video")
      string(JSON uri GET "${config}" packages ${index} rootUri)
      string(REGEX REPLACE "^file:///" "" root "${uri}")
      string(REPLACE "%20" " " root "${root}")
      if(NOT IS_ABSOLUTE "${root}")
        get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../.dart_tool/${root}" ABSOLUTE)
      endif()
      set(${output} "${root}/windows/native-assets.cmake" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "Run flutter pub get: personal media-kit library plugin missing")
endfunction()

function(bilisail_verify_media_assets)
  if(NOT TARGET media_kit_video_plugin OR NOT DEFINED MEDIA_KIT_MPV_SDK)
    message(FATAL_ERROR "Expected personal media-kit native SDK contract")
  endif()
  bilisail_media_manifest(manifest)
  include("${manifest}")
  list(LENGTH MEDIA_KIT_MPV_FILES file_count)
  list(LENGTH MEDIA_KIT_MPV_HASHES hash_count)
  # The pinned ARM64 manifest replaces the six SDK hashes but inherits the
  # x64-only license/provenance filenames. Verify every ARM64 hash against its
  # corresponding SDK file, without requiring that unrelated x64 archive tail.
  if(FLUTTER_TARGET_PLATFORM STREQUAL "windows-arm64" AND hash_count EQUAL 6
      AND file_count GREATER hash_count)
    set(file_count ${hash_count})
  endif()
  if(file_count EQUAL 0 OR NOT file_count EQUAL hash_count)
    message(FATAL_ERROR "Invalid media-kit SDK manifest for ${FLUTTER_TARGET_PLATFORM}: file/hash counts differ or are empty")
  endif()
  math(EXPR last_file "${file_count} - 1")
  foreach(index RANGE 0 ${last_file})
    list(GET MEDIA_KIT_MPV_FILES ${index} file)
    list(GET MEDIA_KIT_MPV_HASHES ${index} expected)
    media_kit_verify_file("${MEDIA_KIT_MPV_SDK}/${file}" "${expected}")
  endforeach()
endfunction()

if(DEFINED BILISAIL_MEDIA_ASSET_CACHE)
  bilisail_media_manifest(manifest)
  set(MEDIA_KIT_ASSET_CACHE "${BILISAIL_MEDIA_ASSET_CACHE}")
  include("${manifest}")
endif()
