+// GTK owns the map and output. libmpv only wakes the attached GSource.
+struct RenderClient {
+  VideoOutputManager* manager;
+  gint64 key;
+  mpv_handle* client;
+  VideoOutput* output;
+  GSource* events;
+};
+
+static gboolean dispatch_events(GSource*, GSourceFunc dispatch, gpointer data) {
+  return dispatch(data);
+}
+
+static GSourceFuncs event_functions = {nullptr, nullptr, dispatch_events, nullptr, nullptr, nullptr};
+
+static gboolean check_shutdown(gpointer data) {
+  auto* lease = static_cast<RenderClient*>(data);
+  g_source_set_ready_time(lease->events, -1);
+  if (media_kit_mpv_shutdown_pending(lease->client)) {
+    g_hash_table_remove(lease->manager->video_outputs, GINT_TO_POINTER(lease->key));
+    return G_SOURCE_REMOVE;
+  }
+  return G_SOURCE_CONTINUE;
+}
+
+static void release_client(gpointer data) {
+  auto* lease = static_cast<RenderClient*>(data);
+  media_kit_mpv_set_wakeup_callback(lease->client, nullptr, nullptr);
+  g_source_destroy(lease->events);
+  g_source_unref(lease->events);
+  g_object_unref(lease->output);
+  mpv_destroy(lease->client);
+  delete lease;
+}
+
