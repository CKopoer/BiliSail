# Allow one platform's SDK to be refreshed without changing the other ABIs.
function(bilisail_fvp_asset platform base_output archive_output hash_output)
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/assets.lock.json" manifest)
  string(JSON base GET "${manifest}" baseUrl)
  string(JSON asset GET "${manifest}" assets "${platform}")
  string(JSON platform_base ERROR_VARIABLE missing_base GET "${asset}" baseUrl)
  if(NOT missing_base)
    set(base "${platform_base}")
  endif()
  string(JSON archive GET "${asset}" archive)
  string(JSON hash GET "${asset}" sha256)
  string(LENGTH "${hash}" hash_length)
  if(NOT hash_length EQUAL 64 OR NOT hash MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Invalid pinned fvp SDK SHA-256 for ${platform}")
  endif()
  set(${base_output} "${base}" PARENT_SCOPE)
  set(${archive_output} "${archive}" PARENT_SCOPE)
  set(${hash_output} "${hash}" PARENT_SCOPE)
endfunction()
