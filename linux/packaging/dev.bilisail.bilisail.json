{
  "app-id": "dev.bilisail.bilisail",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "bilisail",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--talk-name=org.freedesktop.secrets",
    "--own-name=org.mpris.MediaPlayer2.bilisail.*",
    "--env=GDK_BACKEND=x11"
  ],
  "modules": [
    {
      "name": "bilisail",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a . /app/",
        "install -Dm755 flatpak-launcher /app/bin/bilisail",
        "mkdir -p /app/share",
        "cp -a usr/share/applications usr/share/icons /app/share/",
        "rm /app/flatpak-launcher"
      ],
      "sources": [{ "type": "dir", "path": "AppDir" }]
    }
  ]
}
