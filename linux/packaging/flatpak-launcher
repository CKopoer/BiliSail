#!/bin/sh
# Flatpak exposes the desktop's cursor themes at these read-only mounts. The
# bundled Ubuntu Xcursor and wayland-cursor libraries don't search them.
host_icons=/run/host/user-share/icons:/run/host/share/icons
local_icons="${XDG_DATA_HOME:-$HOME/.local/share}/icons:$HOME/.icons"
export XCURSOR_PATH="${XCURSOR_PATH:+$XCURSOR_PATH:}$host_icons:$local_icons:/app/share/icons:/usr/share/icons:/usr/share/pixmaps"
exec /app/AppRun "$@"
