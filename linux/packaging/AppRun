#!/usr/bin/env bash
# Keep Flutter's executable/lib/data layout together in both package formats.
set -e
export APPDIR="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)"
export LD_LIBRARY_PATH="$APPDIR/usr/bin/lib:$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export WEBKIT_INJECTED_BUNDLE_PATH="$APPDIR/usr/lib/x86_64-linux-gnu/webkit2gtk-4.1/injected-bundle"
# The bundled linuxdeploy GTK hook forces X11. Keep the caller's selection
# while loading its GTK resources, then let GDK try the requested backends.
display_backends="${GDK_BACKEND:-wayland,x11}"
for hook in "$APPDIR"/apprun-hooks/*.sh; do
  [[ -f "$hook" ]] && source "$hook"
done
export GDK_BACKEND="$display_backends"
cd "$APPDIR"
exec "$APPDIR/usr/bin/bilisail" "$@"
